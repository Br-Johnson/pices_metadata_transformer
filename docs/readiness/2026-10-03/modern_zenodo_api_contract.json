  "conclusion": {
    "source_supported_route": "POST /api/records (slashless) creates a modern draft via invenio_rdm_records.resources.resources.RDMRecordResource; creation is inherited through invenio_drafts_resources.resources.records.resource.RecordResource from records-resources RecordResource.create.",
    "deployed_zenodo_sandbox_modern_write_support": "UNVERIFIED",
    "legacy500_workaround": "UNPROVEN: modern avoids the legacy deserializer/serializer, but both paths use RDMRecordService creation and the same configured record classes/service components.",
    "official_zenodo_doc": {
      "url": "https://developers.zenodo.org/",
      "observed_date": "2026-10-03",
      "scope": "Documents legacy POST /api/deposit/depositions; its Records section describes published-record GET search/read, without a modern POST /api/records contract. Its new Files API is the legacy bucket API, not the RDM init/content/commit protocol."
    }
  },
  "authentication": {
    "transport": "HTTPS certificate verification enabled; Authorization: Bearer from privately configured token; never query-string credentials.",
    "documented_zenodo_scope": "deposit:write for nonpublishing deposit writes; deposit:actions covers publication actions.",
    "modern_scope_finding": "The examined modern route/config/policy does not declare a route-specific OAuth scope. Creation requires authenticated identity; draft metadata/file actions require owner or configured review/manage permissions. Locked OAuth REST authentication verifies a token with scopes=[] and sets the user identity. Thus a minimum modern token scope, and sufficiency of a deposit:write token on the deployed host, remain unverified. This is not a recommendation to loosen client scope gates.",
    "contract_choice": "Keep deposit:write as a conservative client prerequisite for any separately approved nonpublishing test; no request to broaden scopes or use publication permissions."
  },
  "format": {
    "request_content_type": "application/json",
    "response_accept": "application/vnd.inveniordm.v1+json",
    "reason": "Zenodo overrides application/json to Zenodo legacy record serialization. The modern media type retains RDM fields and adds ui presentation fields. Validate canonical metadata, not ui display data.",
    "response_identity": {
      "id": "string; Zenodo-specific provider generates positive decimal strings",
      "created": "aware ISO timestamp",
      "owner": "parent.access.owned_by.user (string, single object)",
      "is_published": false,
      "status": "draft for a first unrevised, unreviewed draft",
      "versions.index": 1,
      "files": "object with enabled,count,entries keyed by file key; differs from legacy files array"
    },
    "file_endpoint_response": "File-list entries are an array; each file response has key,status,checksum,size and links.self/content/commit. Record files.entries is instead an object."
  },
  "metadata_contract": {
    "strict_minimum_fields": [
      "metadata.title (at least 3 characters)",
      "metadata.resource_type.id (existing depositable vocabulary value)",
      "metadata.publication_date (EDTF date)",
      "metadata.creators (at least one person_or_org object)"
    ],
    "creator_rule": "person_or_org.type is personal (family_name required) or organizational (name required). Do not guess types or split literal PICES credits for production.",
    "optional_schema_fields": [
      "metadata.publisher",
      "metadata.description",
      "metadata.rights"
    ],
    "draft_semantics": "Empty/incomplete drafts can receive201 because create/update use raise_errors=False. The potential adapter must reject returned validation errors, missing required metadata or changed expected fields before further writes.",
    "explicit_access_and_files": {
      "access": {
        "record": "public",
        "files": "restricted"
      },
      "files": {
        "enabled": true
      }
    },
    "test_fixture_example_not_runnable_or_authorized": {
      "metadata": {
        "creators": [
          {
            "person_or_org": {
              "type": "personal",
              "family_name": "Brown",
              "given_name": "Troy"
            }
          }
        ],
        "publication_date": "2020-06-01",
        "resource_type": {
          "id": "image-photo"
        },
        "title": "A Romans story"
      }
    },
    "fixture_explanation": "These values come from the pinned Zenodo test fixture. They are not unique run identity or a proposed live payload. An eventual adapter must bind the explicitly authorized synthetic source/title/artifact/metadata, including the marker in initial create metadata; no new namespace is defined here.",
    "rights": "Do not invent or default new rights. The modern field is metadata.rights; legacy license/access_right is not the request shape."
  },
  "potential_offline_adapter_contract": {
    "enabled": false,
    "request_sequence": [
      {
        "step": "create",
        "method": "POST",
        "path": "/api/records",
        "expect": 201,
        "body": "Explicitly hash-bound synthetic modern access/files/metadata object, not an empty body; marker belongs in initial title.",
        "guard": "Durably consume create allowance and record intent before request. On201 persist returned ID, aware created time, owner and any returned PID before another write. Verify fresh ID, expected metadata, empty files, no errors, first draft status and exact same-host links."
      },
      {
        "step": "metadata_update",
        "method": "PUT",
        "path": "/api/records/{id}/draft",
        "expect": 200,
        "body": "Same approved modern metadata/access/files; preserve returned PID data.",
        "guard": "Only the durably returned ID, same owner/created time/run marker; no cached uncertain-ID adoption."
      },
      {
        "step": "file_init",
        "method": "POST",
        "path": "/api/records/{id}/draft/files",
        "expect": 201,
        "body": [
          {
            "key": "FIXED_APPROVED_ARTIFACT_BASENAME"
          }
        ],
        "guard": "Exactly one expected key; pending status; local transfer only. Validate returned content/commit links against constructed same-host, same-ID/key paths."
      },
      {
        "step": "file_content",
        "method": "PUT",
        "path": "/api/records/{id}/draft/files/{encoded_key}/content",
        "expect": 200,
        "body": "Exact hash-bound bytes; Content-Type application/octet-stream.",
        "guard": "Allowance durably consumed before transport; no implicit retry/remote fetch/multipart."
      },
      {
        "step": "file_commit",
        "method": "POST",
        "path": "/api/records/{id}/draft/files/{encoded_key}/commit",
        "expect": 200,
        "body": null,
        "guard": "Require completed state and expected byte count/checksum; uncertainty permanently stops this grant."
      },
      {
        "step": "readback",
        "method": "GET",
        "paths": [
          "/api/records/{id}/draft",
          "/api/records/{id}/draft/files",
          "/api/records/{id}/draft/files/{encoded_key}",
          "/api/records/{id}/draft/files/{encoded_key}/content"
        ],
        "expect": 200,
        "guard": "Explicit finite read allowance; validate owner/ID/created/status/title, all metadata fields, single file key/size/checksum and optional exact bounded byte hash. A redirect stops; no following links to another host."
      },
      {
        "step": "unchanged_retry",
        "method": "GET",
        "paths": [
          "same previously bound draft/file paths only"
        ],
        "guard": "Completed rerun reuses durable ID and performs no POST or PUT; compare canonical unchanged metadata/file evidence."
      }
    ],
    "write_ceiling_required_if_metadata_put_is_tested": {
      "create_POST": 1,
      "metadata_PUT": 1,
      "file_init_POST": 1,
      "file_content_PUT": 1,
      "file_commit_POST": 1,
      "total_POST": 3,
      "total_PUT": 2,
      "note": "These are separate mutations; the existing legacy1create/1metadataPUT/1filePUT grant does not authorize this protocol."
    },
    "doi_variant": {
      "legacy_fact": "Legacy metadata.prereserve_doi is computed from the numeric record ID by the serializer; do not treat it as modern response state.",
      "modern_optional_action": "POST /api/records/{id}/draft/pids/doi ->201, linked as reserve_doi; resulting identity is pids.doi.identifier/provider.",
      "policy": "Without an actual returned DOI, an equivalent DOI readback contract needs a separately counted and authorized reservation POST (total4POST+2PUT). Alternatively a reviewed draft-only contract must explicitly omit the DOI criterion. Never fabricate a DOI or silently waive an existing criterion."
    },
    "safety_invariants": [
      "No runtime fallback after a legacy500, no failed-state reset, no replenished create allowance, no adoption of an uncertain empty creation by search. All old receipts/budgets/held uncertainty remain intact.",
      "Separate explicit grant/packet/lifetime/namespace decision needed before any provider stage; this research is not that grant.",
      "Reuse existing durable pre-send counters, path isolation, bounded time/response body, no redirects/automatic retries, closed-vocabulary sanitized error projection and exact source/artifact binding.",
      "No constructor full-account scan, hidden endpoint probe or unbudgeted read. Partial old-ID knowledge is only a reject set.",
      "No publish, edit-existing-record, newversion, DOI registration, delete, community submission, production request or generic upload-service fallback."
    ],
    "offline_regression_matrix": [
      "Modern Accept selection vs legacy application/json response",
      "201 with errors/incomplete metadata blocks before next mutation",
      "Malformed/old/colliding ID, missing/wrong owner, stale created timestamp, wrong returned title and nonempty initial files",
      "Cross-host, wrong-ID/file-key, encoded slash and redirect response links",
      "Independent durable budgets for init/content/commit and optional DOI reservation",
      "500/timeout/crash after every mutation consumes its allowance and refuses unsafe resumption",
      "pending before commit; completed only after commit; exact key/size/checksum/byte hash",
      "Completed unchanged retry produces no writes; lost state/journal/PID fails closed",
      "No change to old uncertain creation evidence or production dedup gates"
    ],
    "read_ceiling_candidate": {
      "maximum_GET": 8,
      "allocation": "4 readback GETs plus4 same-ID unchanged-retry GETs; no constructor/list/probe requests. A later design may reduce reads but cannot add hidden calls."
    }
  },
