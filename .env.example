# Explicit client token > selected nonempty environment variable > cwd .env.
# Environment values (including NetworkSecret placeholders) pass unchanged.
# Empty environment variables use the file fallback; modes never cross-fallback.
# Tokens must be nonempty printable ASCII without whitespace; invalid input is rejected.
# Legacy file parsing trims outer whitespace. Valid placeholders pass unchanged.
ZENODO_SANDBOX_TOKEN=your_sandbox_token_here
ZENODO_PRODUCTION_TOKEN=your_production_token_here
